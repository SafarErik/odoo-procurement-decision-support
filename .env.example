# Local development configuration. Copy to .env (ignored by git) and fill the
# blank secrets. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# --- Odoo container and its own PostgreSQL (infra/odoo/compose.yaml) ---
POSTGRES_USER=odoo
POSTGRES_PASSWORD=
POSTGRES_DB=postgres
ODOO_MASTER_PASSWORD=
ODOO_HTTP_PORT=8069

# --- Read-only Odoo JSON-2 access used by the backend ---
# Create API keys in Odoo (user Preferences > Account Security) for the restricted
# integration users; never use an administrator key here.
ODOO_BASE_URL=http://127.0.0.1:8069
ODOO_DATABASE=pdss_history_gen
ODOO_API_KEY=
# Separate key of the portal user that may only call the history addon methods.
ODOO_T7S_API_KEY=
ODOO_REQUEST_TIMEOUT_SECONDS=5
# Model trained offline from Odoo purchase history (python -m tools.train_history_model all),
# e.g. .artifacts/ml/model. Leave blank to refuse new Odoo-history cases.
SUPPLIER_HISTORY_MODEL_DIRECTORY=

# --- Seeding tool only (tools/seed_odoo_history.py); never read by the backend ---
# Must be exactly pdss_history_gen, and that database needs the system parameter
# pdss.seed_target=pdss_history_gen. Administrator key, short duration.
ODOO_SEED_DATABASE=
ODOO_SEED_ADMIN_API_KEY=

# --- Persistent planning database (infra/app/compose.yaml, `python -m tools.dev db-up`) ---
APP_POSTGRES_DB=planning
APP_POSTGRES_USER=planning
APP_POSTGRES_PASSWORD=
APP_POSTGRES_PORT=55440
# Must match the values above, e.g.
# postgresql+psycopg://planning:<password>@127.0.0.1:55440/planning
DECISION_DATABASE_URL=

# --- Backend <-> frontend ---
BACKEND_BASE_URL=http://127.0.0.1:8000
# Shared service secret between the Reflex server and FastAPI. It stays on the
# servers (never in browser state) and is not a user identity.
API_SERVICE_TOKEN=
# Company whose saved cases the case library lists (must equal the saved company_id) and
# whose open Odoo quotation groups the buyer can choose from, e.g. odoo:res.company:1.
PLANNING_LIBRARY_COMPANY_ID=

# --- Disposable test database (infra/persistence/compose.test.yaml) ---
# Integration tests drop and recreate its schema: never point this at real data.
TEST_DATABASE_URL=
TEST_POSTGRES_DB=planning_test
TEST_POSTGRES_USER=planning_test
TEST_POSTGRES_PASSWORD=
TEST_POSTGRES_PORT=55432

# --- Opt-in live Odoo contract tests (need the documented Odoo fixtures) ---
RUN_T6_LIVE_CONTRACTS=false
RUN_T7S_LIVE_CONTRACTS=false
RUN_T7_LIVE_CONTRACTS=false
