# Local development configuration. Copy this file to .env and set both blank
# password values before starting containers. Do not commit .env.

# Odoo and PostgreSQL local environment
POSTGRES_USER=odoo
POSTGRES_PASSWORD=
POSTGRES_DB=postgres
ODOO_MASTER_PASSWORD=
ODOO_HTTP_PORT=8069

# Separate application components
BACKEND_BASE_URL=http://127.0.0.1:8000

# Read-only Odoo JSON-2 integration. Generate ODOO_API_KEY in the local Odoo
# user preferences after creating the database. Leave it blank in this example.
ODOO_BASE_URL=http://127.0.0.1:8069
ODOO_DATABASE=procurement_poc
ODOO_API_KEY=
# Dedicated non-internal T7-S projection caller. Do not reuse ODOO_API_KEY.
ODOO_T7S_API_KEY=
ODOO_REQUEST_TIMEOUT_SECONDS=5

# T11 application persistence. Keep the real URL in the ignored .env only.
# The test database is a separate disposable PostgreSQL service on port 55432.
DECISION_DATABASE_URL=
T11_TEST_DATABASE_URL=
T11_POSTGRES_DB=decision_cases_test
T11_POSTGRES_USER=t11_test
T11_POSTGRES_PASSWORD=
T11_POSTGRES_PORT=55432

# Explicit opt-in after the controlled T6 fixture has been created and checked.
RUN_T6_LIVE_CONTRACTS=false

# Explicit opt-in only after docs/T7S_MANUAL_SETUP.md is complete.
RUN_T7S_LIVE_CONTRACTS=false

# Explicit opt-in after T7-S passes and the controlled historical-receipt fixture
# in docs/T7_FIXTURE_SETUP.md is complete.
RUN_T7_LIVE_CONTRACTS=false
