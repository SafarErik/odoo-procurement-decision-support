# Local development configuration. Copy this file to .env and replace all
# placeholder passwords before starting containers. Do not commit .env.

# Odoo and PostgreSQL local environment
POSTGRES_USER=odoo
POSTGRES_PASSWORD=replace-with-a-long-random-development-password
POSTGRES_DB=postgres
ODOO_MASTER_PASSWORD=replace-with-a-separate-long-random-development-password
ODOO_HTTP_PORT=8069

# Separate application components
BACKEND_BASE_URL=http://127.0.0.1:8000
