# Local development configuration. Copy this file to .env and set both blank
# password values before starting containers. Do not commit .env.

# Odoo and PostgreSQL local environment
POSTGRES_USER=odoo
POSTGRES_PASSWORD=
POSTGRES_DB=postgres
ODOO_MASTER_PASSWORD=
ODOO_HTTP_PORT=8069

# Separate application components
BACKEND_BASE_URL=http://127.0.0.1:8000
